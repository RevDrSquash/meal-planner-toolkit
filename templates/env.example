# Copy to the private workspace as `.env` (never commit that file).
# Then run: python scripts/refresh_token.py --login

# OAuth bearer token from your logged-in browser session (auto-refreshed)
PCEXPRESS_BEARER_TOKEN=your_bearer_token_here

# Your customer/user ID (UUID)
PCEXPRESS_CUSTOMER_ID=your_customer_id_here

# Your active cart ID (UUID; refreshed when the cart rotates)
PCEXPRESS_CART_ID=your_cart_id_here

# Your preferred store's 4-digit ID
PCEXPRESS_STORE_ID=1234

# Store banner: superstore, loblaws, nofrills, zehrs, independent, tandt
PCEXPRESS_BANNER=superstore
