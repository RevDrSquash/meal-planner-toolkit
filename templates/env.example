# Copy to the private workspace as `.env` (never commit that file).
# One-time login (see references/pcexpress.md):
#   python .agents/skills/meal-planner-toolkit/scripts/pcexpress_login.py
# Fallback: python vendor/pcexpress-mcp-server/login_pcid.py

# Refresh token from the one-time PC id login (server rotates it after first use)
PCEXPRESS_REFRESH_TOKEN=your_refresh_token_here

# Writable dir for the rotated refresh token + cached access token.
# Keep this inside the private workspace. Ignore it in the *workspace*
# `.gitignore` (copy templates/gitignore.example). The toolkit
# `.gitignore` does not apply to the parent repo.
PCEXPRESS_STATE_DIR=.pcexpress-mcp

# Store banner: superstore, loblaws, nofrills, zehrs, independent, tandt
PCEXPRESS_BANNER=superstore

# Your preferred store's 4-digit ID
PCEXPRESS_STORE_ID=your_store_id_here

# Customer id and cart id are discovered from your profile at runtime and
# must not be stored here; a pinned cart id only goes stale.
